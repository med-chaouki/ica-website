# ── Server Environment Variables ──────────────────────────────────────
# Copy this file to .env and fill in the values.

# Server
PORT=3000
NODE_ENV=development

# Email — Gmail SMTP
# In production, replace with ICA's official email (e.g. contact@ica-maroc.com)
EMAIL_USER=your_gmail@gmail.com
EMAIL_PASS=your-app-specific-password

# Recipient — where contact/quote form submissions are sent
RECIPIENT_EMAIL=mohamedchaouki089@gmail.com

# Frontend URL — used for CORS in production
FRONTEND_URL=https://your-production-domain.com
